rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }
    
    // App writes via authenticated user or device key (handled in Cloud Functions)
    // Read-only API key handled in Cloud Functions
    // Direct Firestore access is disabled; all access goes through Cloud Functions
  }
}
