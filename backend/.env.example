# Firebase Backend Configuration
# Copy to .env for local development (DO NOT COMMIT .env)

# Firebase Project ID
FIREBASE_PROJECT_ID=fitness-os-backend

# Cloud Functions Region
FUNCTIONS_REGION=us-central1

# Read-only API Key (generate with: openssl rand -hex 32)
# Used by AI coach (Arjun) to query fitness data
READ_ONLY_API_KEY=

# Device Write Key (generate with: openssl rand -hex 32)
# Used by Flutter app to sync data to backend
DEVICE_WRITE_KEY=

# Meal logging write scope (optional, default: false)
MEALS_WRITE_ENABLED=false
