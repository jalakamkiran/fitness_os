# Copy to `.env` and fill in values. `.env` is gitignored — never commit secrets.
#
# Used by Flutter via: --dart-define-from-file=.env
# (wired in .vscode/launch.json)

# Sentry project DSN (Settings → Client Keys). Required for crash/sync observability.
SENTRY_DSN=

# Force Sentry init in debug builds (owner digs). Prefer release/profile.
SENTRY_FORCE=

# Do NOT put SENTRY_AUTH_TOKEN here — dart-define-from-file embeds values in the app binary.
# Export that only in your shell/CI for symbol upload:
#   export SENTRY_AUTH_TOKEN=…
